# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=
ORIGIN="http://localhost:3000"
RP_ID="localhost"
RP_NAME="MealPlan"

LOCAL_S3_REGION="us-east-1"
LOCAL_S3_ENDPOINT="http://rustfs:9000"
LOCAL_S3_ACCESS_KEY_ID="rustfsadmin"
LOCAL_S3_SECRET_ACCESS_KEY="rustfsadmin"
LOCAL_S3_BUCKET=catering

JWT_SECRET=
NODE_ENV=production
NUXT_PUBLIC_APP_ENV=production
NUXT_PUBLIC_SENTRY_DSN=

READ_DATABASE_URL="postgresql://user:password@ip:port/db"
WRITE_DATABASE_URL="postgresql://user:password@ip:port/db"
